# Ollama backend for juror/foreman inference (see agent.py).
# The backend serializes requests, so a full 12-juror ballot runs 12 calls
# back-to-back — a fast reasoning model keeps each ballot under the 90s cap.
# qwen3:latest reasons well (~5s/call warm) and returns clean JSON; larger
# models (35B, 14B) push a ballot past the timeout and stall the vote.
OLLAMA_HOST=http://192.168.178.98:11434
OLLAMA_MODEL=qwen3:latest

# ElevenLabs TTS (see tts.py). Without this, jurors and the narrator
# speak silently — the room still runs, just without audio.
ELEVENLABS_API_KEY=
