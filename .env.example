# Which LLM backend every agent in the room runs on: claude_cli or ollama.
#
# claude_cli (default) shells out to headless `claude -p` — one subprocess per
# agent turn, each with the persona as its entire system prompt and with this
# repo's CLAUDE.md, hooks, output style and tools stripped out, so nothing
# leaks into a juror's voice. Needs a logged-in `claude` on PATH; a full
# 12-juror ballot runs concurrently in roughly the time of a single call.
AGENT_BACKEND=claude_cli

# Models for the claude_cli backend. Jurors speak far more often than anyone
# else and default to the fast model; the foreman, court officer and judge
# make the structural calls that shape the run, so give them the better one if
# a deliberation is drifting.
CLAUDE_MODEL=haiku
CLAUDE_MODEL_FOREMAN=sonnet
# CLAUDE_BIN=claude

# Ollama backend (AGENT_BACKEND=ollama). This instance serializes requests, so
# a full 12-juror ballot runs 12 calls back-to-back — a fast reasoning model
# keeps each ballot under the timeout. qwen3:latest reasons well (~5s/call
# warm) and returns clean JSON; larger models (14B, 35B) push a ballot past
# the cap and stall the vote.
OLLAMA_HOST=http://192.168.178.98:11434
OLLAMA_MODEL=qwen3:latest

# ElevenLabs TTS (see tts.py). Without this, the room runs silently.
ELEVENLABS_API_KEY=
